{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "pull-request-title-pattern": "chore: release ${version}",
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "plugins/att-docs/.claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "plugins/general/.claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "plugins/voice/.claude-plugin/plugin.json", "jsonpath": "$.version" }
      ]
    }
  }
}
