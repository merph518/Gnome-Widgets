# Starts one job now, outside the nightly timer. The instance is the job ID,
# so `systemctl --user start build-pack-now@issue-9415.service` runs
# issue-9415 first, then any other row queued with `queue add --now`, and takes
# no row waiting for the nightly run. It stops taking a new job at the
# configured cutoff. It reads the same env file and runs at the same priority
# as build-pack.service. A second start of an instance that is still running
# merges into it; a job running under another unit is left alone and reported
# as running. A nightly run that starts while this unit still holds the queue
# waits for it.
#
# Install beside build-pack.service:
#   cp build-pack-now@.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#
# The env file is the one build-pack.service reads, with BUILD_PACK_SCRIPT,
# BUILD_PACK_CONFIG, and a full PATH and any token the rule export needs.
#
# If another queue run holds the queue, this unit exits at once and leaves the
# job queued. A nightly run takes it when it is due; a run that works only
# start-now rows takes it only if it is marked now with `queue add --now`.

[Unit]
Description=Build the queued test pack %i now

[Service]
Type=oneshot
EnvironmentFile=%h/.config/build-pack/env
ExecStart=/usr/bin/node ${BUILD_PACK_SCRIPT} queue start --config ${BUILD_PACK_CONFIG} --job %i
Nice=10
