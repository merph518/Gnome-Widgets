{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|mcp__terminal__run_in_terminal|mcp__.*desktop-commander__(write_file|edit_block|move_file|create_directory|write_pdf|start_process|interact_with_process)",
        "hooks": [
          {
            "type": "command",
            "command": "GUARD=\"$CLAUDE_PROJECT_DIR/scripts/guard-main-checkout.sh\"; test -x \"$GUARD\" || exit 0; exec \"$GUARD\""
          }
        ]
      }
    ]
  }
}
