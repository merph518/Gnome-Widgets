#!/usr/bin/env python3
"""Piper voices for the speech widget: lists Piper's published voices and downloads the ones
you name into the folder `speechctl voices` reads.

usage: conky-widgets-voices list [text]     the voices whose name holds text (default en_), * when installed
       conky-widgets-voices add <name>...   download voices, e.g. en_GB-alan-medium

Nothing is downloaded except by `add`. A voice is two files from Piper's voice repository
(huggingface.co/rhasspy/piper-voices), checked against the sizes and checksums its catalog
gives. The folder is ~/.local/share/piper, or SPEAK_PIPER_DIR as speechctl reads it; a new
voice shows in the tray's Voice menu and the widget's ◀ ▶ within half a minute.
"""
import hashlib, json, os, sys, urllib.request

REPO = 'https://huggingface.co/rhasspy/piper-voices/resolve/main/'
PIPER_DIR = os.environ.get('SPEAK_PIPER_DIR') or os.path.expanduser('~/.local/share/piper')
TIMEOUT = 30                                    # seconds without data from the server
CHUNK = 1 << 20


def get(path):
    return urllib.request.urlopen(REPO + path, timeout=TIMEOUT)


def catalog():
    with get('voices.json') as f:
        return json.load(f)


def installed(name):
    return os.path.isfile(os.path.join(PIPER_DIR, name + '.onnx'))


def model_files(voice):
    """The two files a voice is: (repository path, size, md5) for its .onnx and .onnx.json."""
    return [(path, info['size_bytes'], info['md5_digest']) for path, info in voice['files'].items()
            if path.endswith(('.onnx', '.onnx.json'))]


def megabytes(voice):
    return sum(size for path, size, _ in model_files(voice) if path.endswith('.onnx')) / 1e6


def listing(voices, text):
    rows = []
    for name, voice in sorted(voices.items()):
        if text in name:
            rows.append(f"{'*' if installed(name) else ' '} {name:<42} {voice['quality']:<7} "
                        f"{voice['num_speakers']:>5} speaker{'s' if voice['num_speakers'] != 1 else ' '} "
                        f"{megabytes(voice):>4.0f} MB")
    return rows


def download(path, size, md5, target):
    """Fetches path into target through a .part file, so a stopped download leaves no model
    that looks installed; the size and checksum must match the catalog's."""
    part = target + '.part'
    digest = hashlib.md5()
    got = 0
    try:
        with get(path) as src, open(part, 'wb') as out:
            while chunk := src.read(CHUNK):
                out.write(chunk)
                digest.update(chunk)
                got += len(chunk)
                print(f'\r  {os.path.basename(target)}: {got / 1e6:.0f} of {size / 1e6:.0f} MB', end='', file=sys.stderr)
        print(file=sys.stderr)
        if got != size or digest.hexdigest() != md5:
            raise OSError(f'{os.path.basename(target)} does not match the catalog (size {got}, expected {size})')
        os.replace(part, target)
    finally:
        if os.path.exists(part):
            os.remove(part)


def add(voices, names):
    unknown = [name for name in names if name not in voices]
    if unknown:
        print('no such voice: ' + ', '.join(unknown) + '; try: conky-widgets-voices list', file=sys.stderr)
        return 2
    os.makedirs(PIPER_DIR, exist_ok=True)
    for name in names:
        if installed(name):
            print(f'{name} is already in {PIPER_DIR}')
            continue
        print(f'{name} ({megabytes(voices[name]):.0f} MB)')
        # the .onnx.json first: a model without its config is not a voice, and speechctl lists
        # a voice by its .onnx
        for path, size, md5 in sorted(model_files(voices[name]), key=lambda f: f[0].endswith('.onnx')):
            download(path, size, md5, os.path.join(PIPER_DIR, os.path.basename(path)))
        print(f'  added to {PIPER_DIR}')
    return 0


def main(argv):
    command, args = (argv[0], argv[1:]) if argv else ('', [])
    if command == 'list' and len(args) <= 1:
        print('\n'.join(listing(catalog(), args[0] if args else 'en_')))
        return 0
    if command == 'add' and args:
        return add(catalog(), args)
    print('usage: conky-widgets-voices list [text] | add <name>...', file=sys.stderr)
    return 2


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, ValueError) as e:          # no network, a bad download, an unwritable folder
        print(f'conky-widgets-voices: {e}', file=sys.stderr)
        sys.exit(1)
