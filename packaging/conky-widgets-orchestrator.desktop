[Desktop Entry]
Type=Application
Name=Claude Code Orchestrator
GenericName=Claude Code Orchestrator Widget
Comment=The managed Claude sessions and what they have replied
Exec=conky-widgets orchestrator
Icon=utilities-terminal
Terminal=false
StartupNotify=false
Categories=Utility;
Keywords=orchestrator;claude;sessions;conky;widget;
Actions=autostart-on;autostart-off;

[Desktop Action autostart-on]
Name=Start at login
Exec=conky-widgets orchestrator autostart on

[Desktop Action autostart-off]
Name=Don't start at login
Exec=conky-widgets orchestrator autostart off
