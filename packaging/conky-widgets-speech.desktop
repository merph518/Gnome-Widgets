[Desktop Entry]
Type=Application
Name=Speech
GenericName=Speech Widget
Comment=The managed Claude sessions and what they have replied
Exec=conky-widgets speech
Icon=audio-volume-high
Terminal=false
StartupNotify=false
Categories=AudioVideo;Audio;
Keywords=speech;conky;widget;
Actions=autostart-on;autostart-off;

[Desktop Action autostart-on]
Name=Start at login
Exec=conky-widgets speech autostart on

[Desktop Action autostart-off]
Name=Don't start at login
Exec=conky-widgets speech autostart off
